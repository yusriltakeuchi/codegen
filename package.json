    "configuration": {
      "title": "CodeGen",
      "properties": {
        "codegen.templatesDirectory": {
          "type": "string",
          "default": "",
          "description": "Custom global templates directory. If empty, ~/.codegen/templates is used."
        },
        "codegen.overwriteExistingFiles": {
          "type": "boolean",
          "default": false,
          "description": "Allow templates to overwrite existing generated files."
        },
        "globalCodeGenerator.templatesDirectory": {
          "type": "string",
          "default": "",
          "description": "Legacy templates directory configuration alias."
        },
        "globalCodeGenerator.overwriteExistingFiles": {
          "type": "boolean",
          "default": false,
          "description": "Legacy overwrite configuration alias."
        }
      }
