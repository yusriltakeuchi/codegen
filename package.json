  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package",
    "packages": "npm run package",
    "publish": "npm run compile && npx @vscode/vsce publish",
    "install-local": "npm run compile"
  },
